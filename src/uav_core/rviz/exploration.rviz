Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid 10 m
      Enabled: true
      Cell Size: 10
      Plane Cell Count: 10
      Color: 90; 90; 90
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/PointCloud2
      Name: Landing classification
      Enabled: true
      Style: Boxes
      Size (m): 0.9
      Alpha: 1
      Color Transformer: RGB8
      Decay Time: 0
      Topic:
        Value: /viz/classification
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PointCloud2
      Name: Elevation map (height colours)
      Enabled: false
      Style: Boxes
      Size (m): 0.9
      Alpha: 1
      Color Transformer: Intensity
      Channel Name: intensity
      Use rainbow: true
      Invert Rainbow: false
      Autocompute Intensity Bounds: true
      Decay Time: 0
      Topic:
        Value: /viz/elevation
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: Observation states
      Enabled: false
      Alpha: 0.35
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /viz/observation
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Registry zones
      Enabled: true
      Topic:
        Value: /viz/zones
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Frontiers
      Enabled: true
      Topic:
        Value: /viz/frontiers
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: Planned path
      Enabled: true
      Color: 60; 110; 255
      Line Style: Billboards
      Line Width: 0.3
      Topic:
        Value: /viz/path
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Marker
      Name: Vehicle
      Enabled: true
      Topic:
        Value: /viz/vehicle
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Marker
      Name: Status
      Enabled: true
      Topic:
        Value: /viz/status
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Name: Landing cells (old layer)
      Enabled: false
      Topic:
        Value: /viz/landing
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PointCloud2
      Name: Lidar scan (NED)
      Enabled: false
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Topic:
        Value: /cloud_world
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
  Enabled: true
  Global Options:
    Background Color: 40; 40; 40
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 95
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.95
      Yaw: 4.0
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Width: 1400
  Height: 900
  Displays:
    collapsed: false
